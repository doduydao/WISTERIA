    "def show_data_distribution(df):\n",
    "    # Thống kê số lượng các label\n",
    "    label_counts = df[\"label\"].value_counts()\n",
    "    # Tạo phân phối (tỷ lệ phần trăm)\n",
    "    label_distribution = label_counts / label_counts.sum()\n",
    "    \n",
    "    # Hiển thị thống kê và phân phối\n",
    "    print(\"Number of label:\", label_counts.sum())\n",
    "    print(label_counts)\n",
    "    print(\"\\nLabel distribution:\")\n",
    "    print(label_distribution)\n",
    "    \n",
    "    # Vẽ đồ thị biểu diễn phân phối của label\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    plt.bar(label_counts.index, label_counts.values, color='skyblue', alpha=0.8)\n",
    "    plt.xlabel(\"Labels\")\n",
    "    plt.ylabel(\"Number of label\")\n",
    "    plt.title(\"Label distribution:\")\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def compare_data_distribution(df1, df2):\n",
    "    # Thống kê số lượng các label\n",
    "    label_counts_1 = df1[\"label\"].value_counts()\n",
    "    label_counts_2 = df2[\"label\"].value_counts()\n",
    "    \n",
    "    # Tạo phân phối (tỷ lệ phần trăm)\n",
    "    label_distribution_1 = label_counts_1 / label_counts_1.sum()\n",
    "    label_distribution_2 = label_counts_2 / label_counts_2.sum()\n",
    "    \n",
    "    # Hiển thị thống kê\n",
    "    print(\"Number of labels in df1:\", label_counts_1.sum())\n",
    "    print(label_counts_1)\n",
    "    print(\"\\nNumber of labels in df2:\", label_counts_2.sum())\n",
    "    print(label_counts_2)\n",
    "\n",
    "    print(\"\\nLabel distribution in df1:\")\n",
    "    print(label_distribution_1)\n",
    "    print(\"\\nLabel distribution in df2:\")\n",
    "    print(label_distribution_2)\n",
    "    \n",
    "    # Vẽ đồ thị biểu diễn phân phối của label\n",
    "    fig, ax = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "    # Biểu đồ cho df1\n",
    "    ax[0].bar(label_counts_1.index, label_counts_1.values, color='skyblue', alpha=0.8)\n",
    "    ax[0].set_xlabel(\"Labels\")\n",
    "    ax[0].set_ylabel(\"Number of labels\")\n",
    "    ax[0].set_title(\"Label distribution in df1\")\n",
    "    ax[0].tick_params(axis='x', rotation=45)\n",
