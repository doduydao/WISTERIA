   "source": [
    "tlinks = []\n",
    "start_index = 48\n",
    "\n",
    "for i, row in enumerate(C.itertuples(index=False)):\n",
    "    lid = f'l{start_index + i}'\n",
    "    \n",
    "    ent1 = row.entity1_id\n",
    "    ent2 = row.entity2_id\n",
    "    relType = row.label\n",
    "\n",
    "    if ent1.startswith('ei'):\n",
    "        tag1 = f'eventInstanceID=\"{ent1}\"'\n",
    "    else:\n",
    "        tag1 = f'timeID=\"{ent1}\"'\n",
    "\n",
    "    if ent2.startswith('ei'):\n",
    "        tag2 = f'relatedToEventInstance=\"{ent2}\"'\n",
    "    else:\n",
    "        tag2 = f'relatedToTime=\"{ent2}\"'\n",
    "\n",
    "    line = f'<TLINK lid=\"{lid}\" {tag1} {tag2} relType=\"{relType}\"/>'\n",
    "    tlinks.append(line)\n",
    "\n",
    "# In ra kết quả\n",
    "for line in tlinks:\n",
    "    print(line)"
   ]
